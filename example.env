# ==========================================
# GEOPULSE MONOREPO ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# Server & Security Settings
# ------------------------------------------
PORT=8080
ALLOWED_ORIGIN=http://localhost:8080
JWT_SECRET=

# ------------------------------------------
# Database (Embedded SQLite — single binary, no external service)
# ------------------------------------------
# Path to the SQLite database file. ":memory:" yields an ephemeral store.
# In test mode the default is ":memory:"; in production it is "geopulse.db".
DB_PATH=

# ------------------------------------------
# Google OIDC Authentication (Shared)
# ------------------------------------------
# Frontend needs VITE_ prefix to expose it to the browser bundle
# Set VITE_TEST_MODE=true (or NODE_ENV=test) ONLY for local development to
# enable the unauthenticated test-user bypass. Never enable in production.
VITE_GOOGLE_CLIENT_ID=
VITE_TEST_MODE=false
# Setting NODE_ENV=test (in addition to or instead of VITE_TEST_MODE=true)
# also enables unauthenticated test-user mode for local development.
NODE_ENV=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------
# Spatial Upstream APIs (Backend Only - Sealed)
# ------------------------------------------
ORS_API_KEY=

RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
