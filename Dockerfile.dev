# Development image: Go backend with Air hot-reload + Vite dev server
# Used by docker-compose.dev.yml for local development.
FROM golang:1.26-alpine

RUN apk add --no-cache gcc musl-dev nodejs npm
RUN go install github.com/air-verse/air@latest

WORKDIR /app/server

COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/ ./
EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
